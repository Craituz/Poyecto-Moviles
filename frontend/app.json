{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ronaldtubay.yeliscake",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para actualizar tu foto de perfil.",
        "NSPhotoLibraryUsageDescription": "Esta app necesita acceso a tus fotos para actualizar tu perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ronaldtubay.yeliscake",
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite acceder a tus fotos para actualizar tu perfil.",
          "cameraPermission": "Permite acceder a la cámara para tomar tu foto de perfil."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "67e29add-6175-4b3d-bf4c-6a3fb9b5a4d5"
      }
    },
    "owner": "ronaldtubay"
  }
}
